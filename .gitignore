assets/emojis/**/preview_zoom.gif

# API anahtarlari (gizli — asla commit etme)
.env
orchestrator/.env

# Sergi kiosk tarayici profili (web_server open_browsers --user-data-dir)
.tarayici_profili/

# Seslendirme (TTS)
# NOT: .gitignore satir-ici yorumu desteklemez; aciklamalar kendi satirinda.
# uretilen ses onbellegi (runtime)
orchestrator/tts/cache/
# onbellek arsiv yedegi (400MB — GitHub 100MB sinirinin ustunde, sadece lokal)
orchestrator/tts/*.rar
# 60MB ses modeli — README'deki komutla indirilir
orchestrator/tts/voices/*.onnx
orchestrator/tts/voices/*.onnx.json
# kalite testi ciktilari
seslendirme_demo/

# Lisans hatti (bkz. docs/plans/2026-09-11-lisans-ve-kurucu-entegrasyonu.md)
# Sirlar ve makineye bagli dosyalar ASLA depoya girmez; Merkez ~/.luden-lisans/ altinda tutar.
.luden-lisans/
*.key
lisans.dat
lisanslar.json
aktivasyon.dat
# Build ciktilari (Nuitka standalone + icerik paketi)
dist/
build/
web.pak
web-hazir/
