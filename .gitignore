# Sergi kiosk tarayici profili (web_server open_browsers --user-data-dir)
.tarayici_profili/

# Seslendirme (TTS)
# NOT: .gitignore satir-ici yorumu desteklemez; aciklamalar kendi satirinda.
# uretilen ses onbellegi (runtime)
orchestrator/tts/cache/
# onbellek arsiv yedegi (400MB — GitHub 100MB sinirinin ustunde, sadece lokal)
orchestrator/tts/*.rar
# 60MB ses modeli — README'deki komutla indirilir
orchestrator/tts/voices/*.onnx
orchestrator/tts/voices/*.onnx.json
# sergi PC'ye elden tasinacak paket (tts/paket_hazirla.py uretir, ~450MB)
orchestrator/tts/sergi_paketi/
# batch uretim gunlukleri
orchestrator/tts/batch_run*.log
# kalite testi ciktilari
seslendirme_demo/
